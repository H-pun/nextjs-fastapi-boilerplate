# One file, both halves of the app: FastAPI reads it through pydantic-settings
# (api/core/config.py), Next.js reads it through process.env.
#
# Copy to .env and fill in. Never commit .env.

# ── Application ───────────────────────────────────────────────────────────────
PROJECT_NAME="Boilerplate API"
API_V1_STR="/api"
ENVIRONMENT=development
DOMAIN=localhost:3030

# Signs the backend's JWTs *and* encrypts the next-auth session
# (api/core/config.py, src/lib/auth.ts, src/proxy.ts). One value, three readers —
# set them apart and login succeeds while the middleware rejects every request.
# Generate with: openssl rand -base64 32
SECRET_KEY=changethis

# ── Frontend ──────────────────────────────────────────────────────────────────
NEXTAUTH_URL=http://localhost:3030
NEXT_PUBLIC_API_URL=http://localhost:8080

# ── Database (PostgreSQL) ─────────────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changethis
POSTGRES_DB=boilerplate
POSTGRES_SCHEMA=public

# ── Object storage (MinIO / any S3-compatible) ────────────────────────────────
MINIO_URL=http://localhost:9000
MINIO_ROOT_USER=minioadmin
# At least 8 characters, or MinIO refuses to start.
MINIO_ROOT_PASSWORD=minioadmin
# Created on startup if absent (api/core/deps.py).
S3_BUCKET=app

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated origins, or * to allow everything.
BACKEND_CORS_ORIGINS=http://localhost:3030

# ── Keycloak (optional) ───────────────────────────────────────────────────────
# Leave blank to keep username/password as the only way in. Filled in, the login
# page grows a Keycloak button and the backend accepts tokens from this realm.
#
# The backend never holds a secret with Keycloak: it fetches the realm's public
# keys from {KEYCLOAK_ISSUER}/protocol/openid-connect/certs and verifies the
# signature with those. CLIENT_SECRET is next-auth's alone, for the code
# exchange.
#
# Someone signing in through Keycloak for the first time gets an account and the
# Team Member role. Only turn this on for a realm whose members are all meant to
# be here.
#
# KEYCLOAK_ISSUER must match the realm's `iss` claim exactly — compare it
# against {KEYCLOAK_ISSUER}/.well-known/openid-configuration.
# KEYCLOAK_ISSUER=http://localhost:8081/realms/boilerplate
# KEYCLOAK_CLIENT_ID=boilerplate
# KEYCLOAK_CLIENT_SECRET=changethis

# ── Linking one person's second provider ──────────────────────────────────────
# Sign-in is matched on (provider, subject) — never on an email address, which
# anyone able to register it could claim. That leaves one gap: the same person
# arriving through a second provider looks like a stranger, and gets a second
# account.
#
# Naming a provider here closes that gap for it. When its token carries an
# address it marks verified, and some account already holds that same verified
# address, the new identity is attached to that account instead.
#
# Only name providers you trust to check email ownership — not merely to sign
# tokens. Any provider can claim `email_verified: true`; this list records which
# ones mean it. A provider left out still works, its users just link the second
# identity from a signed-in session, where they have already proved who they are.
#
# Comma-separated. Blank (the default) means never link automatically.
# EMAIL_TRUSTED_PROVIDERS=keycloak,google

# ── Optional ──────────────────────────────────────────────────────────────────
# Error monitoring; only initialised when ENVIRONMENT=production.
# SENTRY_DSN=

# Email. Wired into config but not yet used by any feature.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# EMAILS_FROM_EMAIL=
# EMAILS_FROM_NAME=
